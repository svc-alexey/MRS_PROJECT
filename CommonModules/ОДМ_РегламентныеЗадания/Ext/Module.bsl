Процедура ОбработкаЗадания_ВыполнитьInvoke(Знач Идентификатор) Экспорт

	Задача = РегистрыСведений.ОДМ_ЗадачиОбмена.ДанныеЗадачи(Идентификатор);
	ОДМ_ОбменДанными.ВыполнитьПоШаблону(Задача);
	
	// Переиспользуемая задача — возвращаем в очередь только после УСПЕШНОГО выполнения
	Если Перечисления.ОДМ_СтатусыЗадач.ЭтоЗавершенныйСтатус(Задача.Статус)
	   И Задача.Параметры.Свойство("Переиспользуемое")
	   И Задача.Параметры.Переиспользуемое = Истина Тогда
		Задача.Статус  = Перечисления.ОДМ_СтатусыЗадач.Подготовлен;
		Задача.Попытка = 0;
		Задача.Ошибка  = "";
		РегистрыСведений.ОДМ_ЗадачиОбмена.ЗаписатьДанныеЗадач(Задача);
	КонецЕсли;

КонецПроцедуры

