
#Область ОбработчикиСобытий

// Процедура: ОДМ_СправочникиОбменПередЗаписью
// Назначение: Обрабатывает событие перед записью элемента справочника, создавая задачу обмена.
// Входные параметры:
//   Источник - СправочникСсылка - Ссылка на объект, который записывается.
//   Отказ - Булево - Флаг, указывающий на отказ от записи.
Процедура ОДМ_СправочникиОбменПередЗаписью(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ОДМ_ПропуститьОбработку(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	//ОДМ_ОбменДанными.СоздатьЗадачуОбмена(Источник, Отказ);
	
КонецПроцедуры

Процедура ОДМ_ОбъектПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	
	#Если Сервер и Не Сервер Тогда
		Источник = Документы.ОДМ_ХТТПЗапросы.СоздатьДокумент();
		Источник = Справочники.ОДМ_БазыДанных.СоздатьЭлемент();
	#КонецЕсли
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ОДМ_ПропуститьОбработку(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеИмя = Источник.Метаданные().ПолноеИмя();
	
	МестаИспользования = ОДМ_ОбменДанными_ПовтИсп.ПолучитьНастройкиОбменаДляТипаОбъекта(МетаданныеИмя);
	
	Для Каждого МестоИспользования Из МестаИспользования Цикл
		
		Если МестоИспользования.РегистрироватьВУзлеОбмена Тогда
			Источник.ОбменДанными.Получатели.Добавить(МестоИспользования.УзелОбмена);
		КонецЕсли;
		
		//FIXME: пока так :(
		ОписаниеИсточника = ОДМ_ОбменДанными_Переопределяемый.СформироватьОписание(Источник, МестоИспользования.База);
		Если ОписаниеИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//TODO: кэш нужен, минимум для НСИ что бы не гонять объекты
		Если МестоИспользования.КешироватьЗначения Тогда
		//	СтрокаНабора = НаборЗаписей.Добавить();
		//	СтрокаНабора.Ссылка = Источник.Ссылка;
		//	СтрокаНабора.НастройкаОбмена = МестоИспользования.НастройкаОбмена;
		//	СтрокаНабора.ДатаРегистрации = ТекущаяДата();
		КонецЕсли;
		
		Если МестоИспользования.ВыгружатьПриЗаписи Тогда
			
			ОтправляемыйПакет = ОДМ_ОбменДанными.Конструктор_ОписаниеПакетаЗаписиОбъекта();
			ОтправляемыйПакет.ОчищатьТабличнуюЧасть = ОДМ_ОбменДанными.УстановитьСвойство("Булево", Истина);
			ОтправляемыйПакет.ВключитьОбменДанными = ОДМ_ОбменДанными.УстановитьСвойство("Булево", Истина);
			ОтправляемыйПакет.Данные = ОписаниеИсточника;
			
			ВнешнийИнтерфейс = ОДМ_ОбменДанными.Конструктор_ВнешнийИнтерфейс();
			
			//FIXME Отправка в базу в зависимости от Организации в документах
			Если МетаданныеИмя = "Документ.ПоступлениеНаРасчетныйСчет" ИЛИ МетаданныеИмя = "Документ.СписаниеСРасчетногоСчета" Тогда
				
				ОтправляемыйПакет.ВключитьОбменДанными = Ложь;
				
				Если Источник.Проведен Тогда
					ОтправляемыйПакет.Проводить = ОДМ_ОбменДанными.УстановитьСвойство("Булево", Истина);
				КонецЕсли;
				
				ИННОрганизацииОтправки = Источник.Организация.ИНН;
				БазаОтправки = ВернутьДополнительнуюКонстанту("БазаБПИНН-" + ИННОрганизацииОтправки);
				Если НЕ ЗначениеЗаполнено(БазаОтправки) Тогда
					Продолжить;
				КонецЕсли;
				ВнешнийИнтерфейс.ЗаполнитьПараметрыПодключения(БазаОтправки);
			Иначе
				ВнешнийИнтерфейс.ЗаполнитьПараметрыПодключения(МестоИспользования.База);
			КонецЕсли;
			
			
			Асинхронно = Ложь;
			РезультатМетода = ВнешнийИнтерфейс.ОтправитьОбъектНаСервер(ОтправляемыйПакет, Асинхронно);
			
			Если МетаданныеИмя = "Справочник.Контрагенты"
				И РезультатМетода <> Неопределено
				И ТипЗнч(РезультатМетода) = Тип("Структура")
				И РезультатМетода.Свойство("Идентификатор")
				И ЗначениеЗаполнено(РезультатМетода.Идентификатор) Тогда
				
				ОДМ_ОбменДанными_Переопределяемый.ЗаписатьСоответствиеКонтрагентаПослеВыгрузки(
					Источник.Ссылка, МестоИспользования.База, РезультатМетода.Идентификатор);
			КонецЕсли;
			
			//ВыгрузитьДанныеОбъекта(Источник);
			//если выгрузилось, тогда снять из плана обмена
		КонецЕсли;
		
	КонецЦикла;
		
	//Если НаборЗаписей.Количество() > 0 Тогда
	//	НаборЗаписей.Записать();
	//КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытий

#Область СлужебныеПроцедурыИФункции

Функция ОДМ_ПропуститьОбработку(Источник)
	
	ОДМ_ПропуститьОбработку = Ложь;
	
	Если Источник.ДополнительныеСвойства.Свойство("ОДМ_ПропуститьОбработку") Тогда
		ОДМ_ПропуститьОбработку = Источник.ДополнительныеСвойства.ОДМ_ПропуститьОбработку;
	КонецЕсли;
	
	Возврат ОДМ_ПропуститьОбработку;
	
КонецФункции

// Возвращает значение дополнительной константы из регистра сведений.
//
// Параметры:
//  Имя - Строка, Массив - Имя константы или массив имен.
//
// Возвращаемое значение:
//  Произвольный, Структура - Значение константы или структура с значениями для массива имен.
//
Функция ВернутьДополнительнуюКонстанту(Имя) Экспорт
	
	ЕстьПривилегированныйРежим = ПривилегированныйРежим();
	Если ПривилегированныйРежим() Тогда
	иначе
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли; 
	
	ЭтоМассивПараметров = Ложь;
	Результат = Неопределено;
	СтруктураРезультат = Новый Структура;
	
	Запрос = Новый Запрос;
	мТекст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПЛ_ДополнительныеКонстанты.Имя КАК Имя,
	|	ПЛ_ДополнительныеКонстанты.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ПЛ_ДополнительныеКонстанты КАК ПЛ_ДополнительныеКонстанты
	|ГДЕ
	|	ПЛ_ДополнительныеКонстанты.Имя =&Имя";
	
	Если ТипЗнч(Имя)=Тип("Массив") Тогда
		мТекст=СтрЗаменить(мТекст,"=&Имя"," в (&Имя)");
		ЭтоМассивПараметров=Истина;
		Для ффф=0 по Имя.ВГраница() Цикл
			СтруктураРезультат.Вставить(Имя[ффф],Неопределено);
		КонецЦикла; 
	КонецЕсли; 
	
	Запрос.Текст = мТекст;
	Запрос.УстановитьПараметр("Имя", Имя);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого стр Из РезультатЗапроса Цикл
		Если ЭтоМассивПараметров Тогда
			СтруктураРезультат[стр.Имя]=стр.Значение;
		иначе	
			Результат = стр.Значение;
		КонецЕсли; 
	КонецЦикла;
	
	Если ЕстьПривилегированныйРежим Тогда
	иначе
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли; 
	
	возврат ?(ЭтоМассивПараметров=Истина,СтруктураРезультат,Результат);
	
КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
