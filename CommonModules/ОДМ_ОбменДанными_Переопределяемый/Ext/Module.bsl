Процедура ПриОбработкеОбъекта(ОбъектДанных) Экспорт
	
	Временно_ДопискиПоДокументам(ОбъектДанных);
	НормализоватьБанковскийДокументПередЗаписью(ОбъектДанных);
	
КонецПроцедуры

// Записывает соответствие контрагента УХ и внешней базы после успешной выгрузки.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент в текущей ИБ.
//  БазаДанных - Строка - идентификатор внешней базы (например, "WebServ_Mriya_BP").
//  ИдентификаторВнешнейБазы - Строка - GUID контрагента во внешней базе.
Процедура ЗаписатьСоответствиеКонтрагентаПослеВыгрузки(Контрагент, БазаДанных, ИдентификаторВнешнейБазы) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Или Не ЗначениеЗаполнено(ИдентификаторВнешнейБазы) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОДМ_ОбщегоНазначения.ОбъектЯвляетсяГруппой(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьСоответствиеОбъекта(Контрагент, Неопределено, БазаДанных, ИдентификаторВнешнейБазы, "Контрагенты");
	
КонецПроцедуры

#КонецОбласти // ПрограммныйИнтерфейс

#Область ВсякаяВременнаяШляпаЧтоБыНеЛомалаОсновнуюФункциональность

Процедура Временно_ДопискиПоДокументам(ОбъектДанных)
	
	Попытка
		ОМ_СчетаУчетаВДокументах = ОДМ_ОбщегоНазначения.ОбщийМодуль("СчетаУчетаВДокументах");
		ОМ_БухгалтерскийУчетПереопределяемый = ОДМ_ОбщегоНазначения.ОбщийМодуль("БухгалтерскийУчетПереопределяемый");
	Исключение
		//если нет нужных модулей - то не работает так в этой конфе
		Возврат;
	КонецПопытки;
	
	Если ТипЗнч(ОбъектДанных) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		
		ОМ_СчетаУчетаВДокументах.ЗаполнитьСчетаУчетаРасчетов(ОбъектДанных);
		
		Для Каждого СтрокаТЧ Из ОбъектДанных.Услуги Цикл
			СчетаУчета = ОМ_БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(ОбъектДанных.Организация, СтрокаТЧ.Номенклатура);
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СчетаУчета);
			СтрокаТЧ.СчетУчетаНДС = СчетаУчета.СчетУчетаНДС;
			СтрокаТЧ.СчетЗатрат = СчетаУчета.СчетУчета;
			СтрокаТЧ.СчетЗатратНУ = СчетаУчета.СчетУчета;
			СтрокаТЧ.ПодразделениеЗатрат = ОбъектДанных.ПодразделениеОрганизации;
			СтрокаТЧ.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету;
			СтрокаТЧ.Содержание = СтрокаТЧ.Номенклатура.Наименование;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ОбъектДанных) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		ОМ_СчетаУчетаВДокументах.ЗаполнитьСчетаУчетаРасчетов(ОбъектДанных);
		ОбъектДанных.ВидЭлектронногоДокумента = Документы.РеализацияТоваровУслуг.ВидЭлектронногоДокумента(ОбъектДанных);
		
		// Заполняем счета учета и субконто в табличной части
		Для Каждого СтрокаТЧ Из ОбъектДанных.Услуги Цикл
			СчетаУчета = ОМ_БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(ОбъектДанных.Организация, СтрокаТЧ.Номенклатура);
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СчетаУчета);
			СтрокаТЧ.СчетУчетаНДСПоРеализации = СчетаУчета.СчетУчетаНДСПродажи;
			СтрокаТЧ.ПодразделениеОрганизации = ОбъектДанных.ПодразделениеОрганизации;
			НоменклатурнаяГруппаТовара = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Номенклатура, "НоменклатурнаяГруппа");
			СтрокаТЧ.Содержание = СтрокаТЧ.Номенклатура.Наименование;
			
			СтрокаТЧ.Субконто = ?(ЗначениеЗаполнено(НоменклатурнаяГруппаТовара), НоменклатурнаяГруппаТовара, Неопределено);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет подразделение в списании из заявки на расходование (УХ, перед выгрузкой в БП).
//
// Параметры:
//  ОбъектДанных - ДокументОбъект.СписаниеСРасчетногоСчета, ДокументСсылка.СписаниеСРасчетногоСчета.
Процедура ЗаполнитьПодразделениеСписанияПередВыгрузкой(ОбъектДанных)
	
	Если ТипЗнч(ОбъектДанных) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		
		Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектДанных, "ПодразделениеОрганизации")) Тогда
			Возврат;
		КонецЕсли;
		
		ОбъектДокумента = ОбъектДанных.ПолучитьОбъект();
		
	ИначеЕсли ТипЗнч(ОбъектДанных) = Тип("ДокументОбъект.СписаниеСРасчетногоСчета") Тогда
		
		ОбъектДокумента = ОбъектДанных;
		
		Если ЗначениеЗаполнено(ОбъектДокумента.ПодразделениеОрганизации) Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ОбъектДокумента.РасшифровкаПлатежа.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРасшифровки = ОбъектДокумента.РасшифровкаПлатежа[0];
	МетаданныеТЧ = ОбъектДокумента.Метаданные().ТабличныеЧасти.Найти("РасшифровкаПлатежа");
	
	Если МетаданныеТЧ = Неопределено
		Или МетаданныеТЧ.Реквизиты.Найти("ДокументПланирования") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументПланирования = СтрокаРасшифровки.ДокументПланирования;
	Если ТипЗнч(ДокументПланирования) <> Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		Возврат;
	КонецЕсли;
	
	ПодразделениеИзЗаявки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументПланирования, "MRS_Подразделение");
	Если Не ЗначениеЗаполнено(ПодразделениеИзЗаявки) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектДокумента.ПодразделениеОрганизации = ПодразделениеИзЗаявки;
	
	// Вызов по ссылке (ручная выгрузка): пишем отдельно, без повторного обмена.
	// Вызов из ПриЗаписи (объект): подразделение уйдёт в текущую запись документа.
	Если ТипЗнч(ОбъектДанных) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		
		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать();
		ОбъектДокумента.ОбменДанными.Загрузка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

// Перед записью в БП: подставить существующий договор, если из пакета пришла «битая» ссылка.
Процедура НормализоватьБанковскийДокументПередЗаписью(ОбъектДанных)
	
	ТипОбъекта = ТипЗнч(ОбъектДанных);
	
	Если ТипОбъекта <> Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет")
		И ТипОбъекта <> Тип("ДокументОбъект.СписаниеСРасчетногоСчета") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектДанных.ДоговорКонтрагента)
		И Не СсылкаДоговораСуществует(ОбъектДанных.ДоговорКонтрагента) Тогда
		ОбъектДанных.ДоговорКонтрагента = ПодобратьДоговорКонтрагента(ОбъектДанных.Контрагент, ОбъектДанных.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из ОбъектДанных.РасшифровкаПлатежа Цикл
		
		Если ЗначениеЗаполнено(СтрокаТЧ.ДоговорКонтрагента)
			И Не СсылкаДоговораСуществует(СтрокаТЧ.ДоговорКонтрагента) Тогда
			СтрокаТЧ.ДоговорКонтрагента = ОбъектДанных.ДоговорКонтрагента;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.ДоговорКонтрагента) Тогда
			СтрокаТЧ.ДоговорКонтрагента = ПодобратьДоговорКонтрагента(ОбъектДанных.Контрагент, ОбъектДанных.Организация);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.СпособПогашенияЗадолженности)
			И ТипЗнч(СтрокаТЧ.СпособПогашенияЗадолженности) <> Тип("ПеречислениеСсылка.СпособыПогашенияЗадолженности") Тогда
			СтрокаТЧ.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.ПустаяСсылка();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СсылкаДоговораСуществует(ДоговорСсылка)
	
	Если Не ЗначениеЗаполнено(ДоговорСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СсылкаСуществует(ДоговорСсылка);
	
КонецФункции

Функция ПодобратьДоговорКонтрагента(Контрагент, Организация)
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	ОрганизацияПараметр = Справочники.Организации.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ОрганизацияПараметр = Организация;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Контрагент
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И (&Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|		ИЛИ ДоговорыКонтрагентов.Организация = &Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыКонтрагентов.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", ОрганизацияПараметр);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
КонецФункции

#КонецОбласти // ВсякаяВременнаяШляпаЧтоБыНеЛомалаОсновнуюФункциональность

#Область ТакПисатьНеНадо_Временно

// Функция формирует структуру описания объекта для передачи в другую базу данных.
// Поддерживает справочники и документы, включая ПоступлениеНаРасчетныйСчет и СписаниеСРасчетногоСчета.
// Параметры:
//   ОбъектСсылка - Ссылка на объект (справочник или документ).
//   БазаДанных - Строка, идентификатор базы данных (например, "WebServERP" или "БП").
// Возвращаемое значение:
//   Структура - Описание объекта для передачи.
Функция СформироватьОписание(Знач ОбъектСсылка, Знач БазаДанных) Экспорт
	
	Перем РезультатМетода;
	
	Если ТипЗнч(ОбъектСсылка.Ссылка) = Тип("СправочникСсылка.СтатьиЗатрат") Тогда
		
		// Проверяем, отправляем ли в ERP
		Если Строка(БазаДанных) = "WebServERP" Тогда
			// Логика для ПланВидовХарактеристик.СтатьиРасходов (ERP)
			// Заглушка по отправке
			Если НЕ ОбъектСсылка.ЭтоГруппа Тогда
				Если НЕ ОбъектСсылка.АктуальнаяСтатьяСписания Тогда
					РезультатМетода = Неопределено;
					Возврат РезультатМетода;
				КонецЕсли;
			КонецЕсли;
		
			РезультатМетода = ?(ОбъектСсылка.ЭтоГруппа, 
			Новый Структура("Ссылка, Наименование, Код, Родитель, ЭтоГруппа"),
			Новый Структура("Ссылка, Наименование, Код, Родитель, ТипРасходов, ВариантРаспределенияРасходовУпр, ВариантРаспределенияРасходовРегл, ВариантРаспределенияРасходовНУ, АктуальнаяСтатьяСписания, ОграничитьИспользование, ЭтоГруппа"));
			
			РезультатМетода.Ссылка = ОДМ_ОбменДанными.УстановитьСвойство(
			"ПланВидовХарактеристикСсылка.СтатьиРасходов", 
			Строка(ОбъектСсылка.Ссылка.УникальныйИдентификатор()));
			РезультатМетода.Наименование = ОДМ_ОбменДанными.УстановитьСвойство("Строка", ОбъектСсылка.Наименование);
			РезультатМетода.Код = ОДМ_ОбменДанными.УстановитьСвойство("Строка", ОбъектСсылка.Код);
			РезультатМетода.ЭтоГруппа = ОДМ_ОбменДанными.УстановитьСвойство("Булево", ОбъектСсылка.ЭтоГруппа);
			
			Если ЗначениеЗаполнено(ОбъектСсылка.Родитель) Тогда
				РезультатМетода.Родитель = ОДМ_ОбменДанными.УстановитьСвойство(
				"ПланВидовХарактеристикСсылка.СтатьиРасходов", 
				Строка(ОбъектСсылка.Родитель.УникальныйИдентификатор()));
			Иначе
				РезультатМетода.Родитель = ОДМ_ОбменДанными.УстановитьСвойство(
				"ПланВидовХарактеристикСсылка.СтатьиРасходов", "");
			КонецЕсли;
			
			Если НЕ ОбъектСсылка.ЭтоГруппа Тогда
				ТипРасходов = "ПрочиеРасходы";
				РезультатМетода.ТипРасходов = ОДМ_ОбменДанными.УстановитьСвойство(
				"ПеречислениеСсылка.ТипыРасходов", 
				ТипРасходов);
				РезультатМетода.АктуальнаяСтатьяСписания = ОДМ_ОбменДанными.УстановитьСвойство("Булево", ОбъектСсылка.АктуальнаяСтатьяСписания);
				РезультатМетода.ОграничитьИспользование = ОДМ_ОбменДанными.УстановитьСвойство("Булево", НЕ(ОбъектСсылка.АктуальнаяСтатьяСписания));
				
				Если ОбъектСсылка.АктуальнаяСтатьяСписания Тогда
					РезультатМетода.ВариантРаспределенияРасходовУпр = ОДМ_ОбменДанными.УстановитьСвойство("ПеречислениеСсылка.ВариантыРаспределенияРасходов","НеРаспределять");
					РезультатМетода.ВариантРаспределенияРасходовРегл = ОДМ_ОбменДанными.УстановитьСвойство("ПеречислениеСсылка.ВариантыРаспределенияРасходов","НеРаспределять");
