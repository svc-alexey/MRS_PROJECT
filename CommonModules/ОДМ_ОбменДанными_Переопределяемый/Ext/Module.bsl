		РасшифровкаПлатежа = Новый Массив;
		
		Для Каждого СтрокаПлатежа из ОбъектСсылка.РасшифровкаПлатежа Цикл
			
			СтрокаРасшифровкиПлатежа = Новый Структура("ДоговорКонтрагента, СтавкаНДС, СуммаПлатежа, СуммаНДС,
			|СпособПогашенияЗадолженности, СтатьяДвиженияДенежныхСредств,
			|КурсВзаиморасчетов, СуммаВзаиморасчетов,
			|СчетУчетаРасчетовПоАвансам, СчетУчетаРасчетовСКонтрагентом");
			
			СтрокаРасшифровкиПлатежа.ДоговорКонтрагента = УстановитьСвойствоДоговораДляОбмена(
				ИспользуемаяИБ, СтрокаПлатежа.ДоговорКонтрагента);
			
			Если ЗначениеЗаполнено(СтрокаПлатежа.СпособПогашенияЗадолженности) Тогда
				СтрокаРасшифровкиПлатежа.СпособПогашенияЗадолженности = УстановитьСвойствоПеречисленияДляОбмена(
					"ПеречислениеСсылка.СпособыПогашенияЗадолженности",
					СтрокаПлатежа.СпособПогашенияЗадолженности);
			КонецЕсли;
			СтрокаРасшифровкиПлатежа.СуммаПлатежа = ОДМ_ОбменДанными.УстановитьСвойство("Число", СтрокаПлатежа.СуммаПлатежа);
			СтрокаРасшифровкиПлатежа.СуммаНДС = ОДМ_ОбменДанными.УстановитьСвойство("Число", СтрокаПлатежа.СуммаНДС);
			
			СтрокаРасшифровкиПлатежа.КурсВзаиморасчетов = ОДМ_ОбменДанными.УстановитьСвойство("Число", СтрокаПлатежа.КурсВзаиморасчетов);
			СтрокаРасшифровкиПлатежа.СуммаВзаиморасчетов = ОДМ_ОбменДанными.УстановитьСвойство("Число", СтрокаПлатежа.СуммаВзаиморасчетов);
			
			Если ЗначениеЗаполнено(СтрокаПлатежа.СтавкаНДС) Тогда
				СтрокаРасшифровкиПлатежа.СтавкаНДС = УстановитьСвойствоПеречисленияДляОбмена(
					"ПеречислениеСсылка.СтавкиНДС",
					СтрокаПлатежа.СтавкаНДС);
			КонецЕсли;
			
			СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, СтрокаПлатежа.СтатьяДвиженияДенежныхСредств);
			Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
				СтрокаРасшифровкиПлатежа.СтатьяДвиженияДенежныхСредств = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.СтатьиДвиженияДенежныхСредств", СоответствиеВнешнейБазы);
			Иначе
				СтрокаРасшифровкиПлатежа.СтатьяДвиженияДенежныхСредств = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.СтатьиДвиженияДенежныхСредств", Строка(СтрокаПлатежа.СтатьяДвиженияДенежныхСредств.Ссылка.УникальныйИдентификатор()));
			КонецЕсли;
			
			СтрокаРасшифровкиПлатежа.СчетУчетаРасчетовПоАвансам = ОДМ_ОбменДанными.УстановитьСвойство(
			"ПланСчетовСсылка.Хозрасчетный", СтрокаПлатежа.СчетУчетаРасчетовПоАвансам.Код);
			
			СтрокаРасшифровкиПлатежа.СчетУчетаРасчетовСКонтрагентом = ОДМ_ОбменДанными.УстановитьСвойство(
			"ПланСчетовСсылка.Хозрасчетный", СтрокаПлатежа.СчетУчетаРасчетовСКонтрагентом.Код);
			
			// Добавляем строку в табличную часть
			РасшифровкаПлатежа.Добавить(СтрокаРасшифровкиПлатежа);
		КонецЦикла;
		
		// Устанавливаем табличную часть в результат
		РезультатМетода.РасшифровкаПлатежа = РасшифровкаПлатежа;
		
		
		// СчетУчетаРасчетовСКонтрагентом
		РезультатМетода.СчетУчетаРасчетовСКонтрагентом = ОДМ_ОбменДанными.УстановитьСвойство(
		"ПланСчетовСсылка.Хозрасчетный", ОбъектСсылка.СчетУчетаРасчетовСКонтрагентом.Код);
		
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ОбъектСсылка.СтатьяДвиженияДенежныхСредств);
		Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			РезультатМетода.СтатьяДвиженияДенежныхСредств = ОДМ_ОбменДанными.УстановитьСвойство(
			"СправочникСсылка.СтатьиДвиженияДенежныхСредств", СоответствиеВнешнейБазы);
		Иначе
			РезультатМетода.СтатьяДвиженияДенежныхСредств = ОДМ_ОбменДанными.УстановитьСвойство(
			"СправочникСсылка.СтатьиДвиженияДенежныхСредств", Строка(ОбъектСсылка.СтатьяДвиженияДенежныхСредств.Ссылка.УникальныйИдентификатор()));
		КонецЕсли;
		
		//Если ЗначениеЗаполнено(ОбъектСсылка.СтатьяДвиженияДенежныхСредствЗачисление) Тогда
		//	СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ОбъектСсылка.СтатьяДвиженияДенежныхСредствЗачисление);
		//	Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
		//		РезультатМетода.СтатьяДвиженияДенежныхСредствЗачисление = ОДМ_ОбменДанными.УстановитьСвойство(
		//		"СправочникСсылка.СтатьиДвиженияДенежныхСредств", СоответствиеВнешнейБазы);
		//	Иначе
		//		РезультатМетода.СтатьяДвиженияДенежныхСредствЗачисление = ОДМ_ОбменДанными.УстановитьСвойство(
		//		"СправочникСсылка.СтатьиДвиженияДенежныхСредств", Строка(ОбъектСсылка.СтатьяДвиженияДенежныхСредствЗачисление.Ссылка.УникальныйИдентификатор()));
		//	КонецЕсли;
		//КонецЕсли;
		
		// НазначениеПлатежа
		РезультатМетода.НазначениеПлатежа = ОДМ_ОбменДанными.УстановитьСвойство("Строка", ОбъектСсылка.НазначениеПлатежа);
		
		// Комментарий (с префиксом)
		РезультатМетода.Комментарий = ОДМ_ОбменДанными.УстановитьСвойство("Строка", "Синхронизация 1С УХ-БП / " + ОбъектСсылка.Комментарий);
		
		РезультатМетода.ПометкаУдаления = ОДМ_ОбменДанными.УстановитьСвойство("Булево", ОбъектСсылка.ПометкаУдаления);
		
	КонецЕсли;
	
	Возврат РезультатМетода;
	
КонецФункции

Процедура УстановитьКонтрагентВОписанииОбмена(РезультатМетода, ИспользуемаяИБ, КонтрагентСсылка, БазаДанных)
	
	Если Не ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(КонтрагентСсылка) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, КонтрагентСсылка);
		Если Не ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			ИспользуемаяИБЗУП = Справочники.ВнешниеИнформационныеБазы.НайтиПоКоду("00000007");
			СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБЗУП, КонтрагентСсылка);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			РезультатМетода.Контрагент = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.ФизическиеЛица", Строка(КонтрагентСсылка.УникальныйИдентификатор()));
		Иначе
			РезультатМетода.Контрагент = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.ФизическиеЛица", СоответствиеВнешнейБазы);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(КонтрагентСсылка) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, КонтрагентСсылка);
	Если Не ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
		ОбеспечитьСоответствиеКонтрагента(КонтрагентСсылка, БазаДанных);
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, КонтрагентСсылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
		РезультатМетода.Контрагент = ОДМ_ОбменДанными.УстановитьСвойство(
			"СправочникСсылка.Контрагенты", СоответствиеВнешнейБазы);
	Иначе
		// Сверка банковских документов идёт по общему GUID — передаём идентификатор контрагента из УХ.
		РезультатМетода.Контрагент = ОДМ_ОбменДанными.УстановитьСвойство(
			"СправочникСсылка.Контрагенты", Строка(КонтрагентСсылка.УникальныйИдентификатор()));
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает владельца банковского счёта в описании обмена (как контрагента в списании).
//
// Параметры:
//  РезультатМетода - Структура - описание банковского счёта для передачи.
//  ИспользуемаяИБ - СправочникСсылка.ВнешниеИнформационныеБазы - база-приёмник.
//  ВладелецСсылка - СправочникСсылка - контрагент, организация или физлицо.
//  БазаДанных - Строка - идентификатор внешней базы.
Процедура УстановитьВладельцаСчетаВОписанииОбмена(РезультатМетода, ИспользуемаяИБ, ВладелецСсылка, БазаДанных)
	
	Если Не ЗначениеЗаполнено(ВладелецСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецСсылка) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ВладелецСсылка);
		Если Не ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			ИспользуемаяИБЗУП = Справочники.ВнешниеИнформационныеБазы.НайтиПоКоду("00000007");
			СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБЗУП, ВладелецСсылка);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			РезультатМетода.Владелец = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.ФизическиеЛица", Строка(ВладелецСсылка.УникальныйИдентификатор()));
		Иначе
			РезультатМетода.Владелец = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.ФизическиеЛица", СоответствиеВнешнейБазы);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(ВладелецСсылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ВладелецСсылка);
		Если Не ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			ОбеспечитьСоответствиеКонтрагента(ВладелецСсылка, БазаДанных);
			СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ВладелецСсылка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			РезультатМетода.Владелец = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Контрагенты", СоответствиеВнешнейБазы);
		Иначе
			РезультатМетода.Владелец = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Контрагенты", Строка(ВладелецСсылка.УникальныйИдентификатор()));
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(ВладелецСсылка) = Тип("СправочникСсылка.Организации") Тогда
		
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ВладелецСсылка);
		Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			РезультатМетода.Владелец = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Организации", СоответствиеВнешнейБазы);
		Иначе
			РезультатМетода.Владелец = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Организации", Строка(ВладелецСсылка.УникальныйИдентификатор()));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает банковский счёт в описании документа (с предварительной выгрузкой счёта и владельца).
//
// Параметры:
//  РезультатМетода - Структура - описание документа.
//  ИмяПоля - Строка - имя поля (СчетКонтрагента, СчетОрганизации).
//  СчетСсылка - СправочникСсылка.БанковскиеСчета - банковский счёт в УХ.
//  ИспользуемаяИБ - СправочникСсылка.ВнешниеИнформационныеБазы.
//  БазаДанных - Строка.
Процедура УстановитьБанковскийСчетВОписанииОбмена(РезультатМетода, ИмяПоля, СчетСсылка, ИспользуемаяИБ, БазаДанных)
	
	Если Не ЗначениеЗаполнено(СчетСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, СчетСсылка);
	Если Не ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
		ОбеспечитьСоответствиеБанковскогоСчета(СчетСсылка, БазаДанных);
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, СчетСсылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
		РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(
			"СправочникСсылка.БанковскиеСчета", СоответствиеВнешнейБазы);
	Иначе
		РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(
			"СправочникСсылка.БанковскиеСчета", Строка(СчетСсылка.УникальныйИдентификатор()));
	КонецЕсли;
	
КонецПроцедуры

Функция ОбеспечитьСоответствиеКонтрагента(Контрагент, БазаДанных)
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОДМ_ОбщегоНазначения.ОбъектЯвляетсяГруппой(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИспользуемаяИБ = ОДМ_ОбменДанными.ВернутьДополнительнуюКонстанту("MRS_DataExchange_Base_" + БазаДанных);
	СоответствиеКонтрагента = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, Контрагент);
	Если ЗначениеЗаполнено(СоответствиеКонтрагента) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ИдентификаторКонтрагента = ОтправитьОбъектВоВнешнююБазу(Контрагент, БазаДанных);
	Возврат ЗначениеЗаполнено(ИдентификаторКонтрагента);
	
КонецФункции

Функция УстановитьСвойствоДоговораДляОбмена(ИспользуемаяИБ, ДоговорСсылка)
	
	Если Не ЗначениеЗаполнено(ДоговорСсылка) Тогда
		Возврат ОДМ_ОбменДанными.УстановитьСвойство(
			"СправочникСсылка.ДоговорыКонтрагентов",
			"00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ДоговорСсылка);
	
	Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
		Возврат ОДМ_ОбменДанными.УстановитьСвойство("СправочникСсылка.ДоговорыКонтрагентов", СоответствиеВнешнейБазы);
	КонецЕсли;
	
	// Сверка банковских документов идёт по общему GUID — пробуем тот же идентификатор договора.
	Возврат ОДМ_ОбменДанными.УстановитьСвойство(
		"СправочникСсылка.ДоговорыКонтрагентов",
		Строка(ДоговорСсылка.УникальныйИдентификатор()));
	
КонецФункции

Функция УстановитьСвойствоПеречисленияДляОбмена(ИмяТипаПеречисления, ЗначениеПеречисления)
	
	Если Не ЗначениеЗаполнено(ЗначениеПеречисления) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяЗначения = ПолучитьИмяЗначенияПеречисления(ЗначениеПеречисления);
	
	Возврат ОДМ_ОбменДанными.УстановитьСвойство(ИмяТипаПеречисления, ИмяЗначения);
	
КонецФункции

// Вспомогательная функция для получения имени значения перечисления
Функция ПолучитьИмяЗначенияПеречисления(ЗначениеПеречисления)
	
	Если Не ЗначениеЗаполнено(ЗначениеПеречисления) Тогда
		Возврат "";
	КонецЕсли;
	
	// Получаем метаданные перечисления
	МетаданныеПеречисления = ЗначениеПеречисления.Метаданные();
	ИмяПеречисления = МетаданныеПеречисления.Имя;
	
	// Находим индекс значения в перечислении
	ИндексЗначения = Перечисления[ИмяПеречисления].Индекс(ЗначениеПеречисления);
	
	// Получаем имя значения по индексу
	ИмяЗначения = МетаданныеПеречисления.ЗначенияПеречисления[ИндексЗначения].Имя;
	
	Возврат ИмяЗначения;
	
КонецФункции

// Вспомогательная функция для получения имени значения перечисления
Функция ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ОбъектТекущейИБ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"
	|ВЫБРАТЬ
	|	СоответствиеОбъектовТекущейИВнешнихИБ.ОбъектВнешнейИБ КАК ОбъектВнешнейИБ,
	|	СоответствиеОбъектовТекущейИВнешнихИБ.ИспользуемаяИБ КАК ИспользуемаяИБ
	|ИЗ
	|	РегистрСведений.СоответствиеОбъектовТекущейИВнешнихИБ КАК СоответствиеОбъектовТекущейИВнешнихИБ
	|ГДЕ
	|	СоответствиеОбъектовТекущейИВнешнихИБ.ОбъектТекущейИБ = &ОбъектТекущейИБ
	|	И СоответствиеОбъектовТекущейИВнешнихИБ.ИспользуемаяИБ = &ИспользуемаяИБ
	|";
	
	Запрос.УстановитьПараметр("ИспользуемаяИБ", ИспользуемаяИБ);
	Запрос.УстановитьПараметр("ОбъектТекущейИБ", ОбъектТекущейИБ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ОбъектВнешнейИБ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаполнитьСубконтоДляОбмена(РезультатМетода, ИмяПоля, ЗначениеСубконто, ИспользуемаяИБ, БазаДанных)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеСубконто) Тогда
		Возврат;
	КонецЕсли;
	
	ТипСубконто = ТипЗнч(ЗначениеСубконто);
	ТипСубконтоСтрокой = Строка(ТипСубконто);
	ЭтоФизлицо = ТипСубконто = Тип("СправочникСсылка.ФизическиеЛица")
		ИЛИ ТипСубконтоСтрокой = "Физическое лицо";
	ЭтоКонтрагент = ТипСубконто = Тип("СправочникСсылка.Контрагенты")
		ИЛИ ТипСубконтоСтрокой = "Контрагент";
	
	Если ЭтоФизлицо Тогда
		ТипСубконтоСтрокой = "СправочникСсылка.ФизическиеЛица";
	ИначеЕсли ЭтоКонтрагент Тогда
		ТипСубконтоСтрокой = "СправочникСсылка.Контрагенты";
	КонецЕсли;
	
	ЭтоСсылочныйТип = Лев(ТипСубконтоСтрокой, 16) = "СправочникСсылка"
		ИЛИ Лев(ТипСубконтоСтрокой, 14) = "ДокументСсылка"
		ИЛИ Лев(ТипСубконтоСтрокой, 27) = "ПланВидовХарактеристикСсылка"
		ИЛИ ЭтоФизлицо
		ИЛИ ЭтоКонтрагент;
	
	Если НЕ ЭтоСсылочныйТип Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ЗначениеСубконто);
	Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
		РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(ТипСубконтоСтрокой, СоответствиеВнешнейБазы);
		Возврат;
	КонецЕсли;

	Если ЭтоФизлицо Тогда
		
		ИспользуемаяИБЗУП = Справочники.ВнешниеИнформационныеБазы.НайтиПоКоду("00000007");
		Если ЗначениеЗаполнено(ИспользуемаяИБЗУП) Тогда
			СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБЗУП, ЗначениеСубконто);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.ФизическиеЛица", СоответствиеВнешнейБазы);
		Иначе
			РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.ФизическиеЛица", Строка(ЗначениеСубконто.УникальныйИдентификатор()));
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли ЭтоКонтрагент Тогда
		
		ОбеспечитьСоответствиеКонтрагента(ЗначениеСубконто, БазаДанных);
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ЗначениеСубконто);
		
		Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
			РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Контрагенты", СоответствиеВнешнейБазы);
		Иначе
			РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Контрагенты", Строка(ЗначениеСубконто.УникальныйИдентификатор()));
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипСубконтоСтрокой = "СправочникСсылка.ПрочиеДоходыИРасходы"
		ИЛИ ТипСубконтоСтрокой = "СправочникСсылка.ВидыНалоговИПлатежейВБюджет"
		ИЛИ ТипСубконтоСтрокой = "СправочникСсылка.Пользователи" Тогда
		РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(ТипСубконтоСтрокой, ЗначениеСубконто.Наименование);
		Возврат;
	КонецЕсли;
	
	РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство(
		ТипСубконтоСтрокой,
		Строка(ЗначениеСубконто.УникальныйИдентификатор()));
	
	ЗаписатьСобытиеВЖурналРегистрации(ТипСубконтоСтрокой, ТипСубконто, БазаДанных, ЗначениеСубконто);
	
КонецПроцедуры

Функция ОбеспечитьСоответствиеБанковскогоСчета(Счет, БазаДанных)
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИспользуемаяИБ = ОДМ_ОбменДанными.ВернутьДополнительнуюКонстанту("MRS_DataExchange_Base_" + БазаДанных);
	СоответствиеСчета = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, Счет);
	Если ЗначениеЗаполнено(СоответствиеСчета) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Счет.Банк) Тогда
		Банк = Счет.Банк;
		СоответствиеБанка = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, Банк);
		Если НЕ ЗначениеЗаполнено(СоответствиеБанка) Тогда
			ИдентификаторБанка = НайтиИдентификаторБанкаВоВнешнейБазе(Банк, БазаДанных);
			Если НЕ ЗначениеЗаполнено(ИдентификаторБанка) Тогда
				ИдентификаторБанка = ОтправитьОбъектВоВнешнююБазу(Банк, БазаДанных);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИдентификаторБанка) Тогда
				ЗаписатьСоответствиеОбъекта(Банк, ИспользуемаяИБ, БазаДанных, ИдентификаторБанка, "Банки");
			Иначе
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ИдентификаторСчета = ОтправитьОбъектВоВнешнююБазу(Счет, БазаДанных);
	Если НЕ ЗначениеЗаполнено(ИдентификаторСчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаписатьСоответствиеОбъекта(Счет, ИспользуемаяИБ, БазаДанных, ИдентификаторСчета, "БанковскиеСчета");
	Возврат Истина;
	
КонецФункции

Процедура УстановитьСсылкуСтраныМираВОписании(РезультатМетода, ИмяПоля, Страна, ИспользуемаяИБ, БазаДанных)
	
	Если Не ЗначениеЗаполнено(Страна) Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеСтраны = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, Страна);
	Если ЗначениеЗаполнено(СоответствиеСтраны) Тогда
		РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство("СправочникСсылка.СтраныМира", СоответствиеСтраны);
		Возврат;
	КонецЕсли;
	
	// GUID стран в УХ и БП не совпадают — в пакет передаём код (или наименование), поиск на стороне приёмника.
	РеквизитыСтраны = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Страна, "Код, Наименование");
	ЗначениеДляПакета = "";
	
	Если ЗначениеЗаполнено(РеквизитыСтраны.Код) Тогда
		ЗначениеДляПакета = РеквизитыСтраны.Код;
	ИначеЕсли ЗначениеЗаполнено(РеквизитыСтраны.Наименование) Тогда
		ЗначениеДляПакета = РеквизитыСтраны.Наименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеДляПакета) Тогда
		РезультатМетода[ИмяПоля] = ОДМ_ОбменДанными.УстановитьСвойство("СправочникСсылка.СтраныМира", ЗначениеДляПакета);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиИдентификаторБанкаВоВнешнейБазе(Банк, БазаДанных)
	
	Если НЕ ЗначениеЗаполнено(Банк) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеЗапроса = ОДМ_ОбменДанными.Конструктор_ОписаниеЗапросаВнешнейБазы();
	ВнешнийИнтерфейс = ОДМ_ОбменДанными.Конструктор_ВнешнийИнтерфейс();
	ВнешнийИнтерфейс.ЗаполнитьПараметрыПодключения(БазаДанных);
	
	Если ЗначениеЗаполнено(Банк.Наименование) Тогда
		ОписаниеЗапроса.ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Банки.Ссылка)) КАК ГУИД
		|ИЗ
		|	Справочник.Банки КАК Банки
		|ГДЕ
		|	НЕ Банки.ПометкаУдаления
		|	И Банки.Наименование = &Наименование";
		ОписаниеЗапроса.Параметры.Вставить("Наименование", Банк.Наименование);
		
		Данные = ВнешнийИнтерфейс.ОтправитьЗапросНаСервер(ОписаниеЗапроса, Ложь);
		Если Данные <> Неопределено И Данные.Количество() > 0 Тогда
			Возврат Строка(Данные[0].ГУИД);
		КонецЕсли;
		
		ОписаниеЗапроса.Параметры.Очистить();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Банк.Код) Тогда
		ОписаниеЗапроса.ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Банки.Ссылка)) КАК ГУИД
		|ИЗ
		|	Справочник.Банки КАК Банки
		|ГДЕ
		|	НЕ Банки.ПометкаУдаления
		|	И Банки.Код = &Код";
		ОписаниеЗапроса.Параметры.Вставить("Код", Банк.Код);
		
		Данные = ВнешнийИнтерфейс.ОтправитьЗапросНаСервер(ОписаниеЗапроса, Ложь);
		Если Данные <> Неопределено И Данные.Количество() > 0 Тогда
			Возврат Строка(Данные[0].ГУИД);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОтправитьОбъектВоВнешнююБазу(СсылкаОбъекта, БазаДанных)
	
	ОписаниеИсточника = СформироватьОписание(СсылкаОбъекта, БазаДанных);
	Если ОписаниеИсточника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОтправляемыйПакет = ОДМ_ОбменДанными.Конструктор_ОписаниеПакетаЗаписиОбъекта();
	ОтправляемыйПакет.ОчищатьТабличнуюЧасть = ОДМ_ОбменДанными.УстановитьСвойство("Булево", Истина);
	ОтправляемыйПакет.ВключитьОбменДанными = ОДМ_ОбменДанными.УстановитьСвойство("Булево", Истина);
	ОтправляемыйПакет.Данные = ОписаниеИсточника;
	
	ВнешнийИнтерфейс = ОДМ_ОбменДанными.Конструктор_ВнешнийИнтерфейс();
	ВнешнийИнтерфейс.ЗаполнитьПараметрыПодключения(БазаДанных);
	РезультатМетода = ВнешнийИнтерфейс.ОтправитьОбъектНаСервер(ОтправляемыйПакет, Ложь);
	
	Если РезультатМетода <> Неопределено
		И ТипЗнч(РезультатМетода) = Тип("Структура")
		И РезультатМетода.Свойство("Идентификатор") Тогда
		
		ИдентификаторОбъекта = РезультатМетода.Идентификатор;
		
		Если ТипЗнч(СсылкаОбъекта) = Тип("СправочникСсылка.Контрагенты") Тогда
			ЗаписатьСоответствиеКонтрагентаПослеВыгрузки(СсылкаОбъекта, БазаДанных, ИдентификаторОбъекта);
		КонецЕсли;
		
		Возврат ИдентификаторОбъекта;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьИмяБазыОбмена(БазаДанных)
	
	Если ТипЗнч(БазаДанных) = Тип("СправочникСсылка.ОДМ_БазыДанных") Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БазаДанных, "Наименование");
	КонецЕсли;
	
	Возврат Строка(БазаДанных);
	
КонецФункции

// Возвращает ссылку Справочник.ВнешниеИнформационныеБазы для записи в регистр соответствий.
Функция РазрешитьИспользуемуюИБ(ИспользуемаяИБ, БазаДанных)
	
	Если ТипЗнч(ИспользуемаяИБ) = Тип("СправочникСсылка.ВнешниеИнформационныеБазы") Тогда
		Возврат ИспользуемаяИБ;
	КонецЕсли;
	
	ИмяБазы = ПолучитьИмяБазыОбмена(БазаДанных);
	Если Не ЗначениеЗаполнено(ИмяБазы) Тогда
		Возврат Справочники.ВнешниеИнформационныеБазы.ПустаяСсылка();
	КонецЕсли;
	
	ЗначениеКонстанты = ОДМ_ОбменДанными.ВернутьДополнительнуюКонстанту("MRS_DataExchange_Base_" + ИмяБазы);
	Если ТипЗнч(ЗначениеКонстанты) = Тип("СправочникСсылка.ВнешниеИнформационныеБазы") Тогда
		Возврат ЗначениеКонстанты;
	КонецЕсли;
	
	Возврат Справочники.ВнешниеИнформационныеБазы.НайтиПоНаименованию(ИмяБазы, Истина);
	
КонецФункции

Процедура ЗаписатьСоответствиеОбъекта(ОбъектТекущейИБ, ИспользуемаяИБ, БазаДанных, ИдентификаторБП, ИмяОбъектаМетаданных)
	
	ИспользуемаяИБ = РазрешитьИспользуемуюИБ(ИспользуемаяИБ, БазаДанных);
	Если Не ЗначениеЗаполнено(ИспользуемаяИБ) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоответствиеВнешнимИБ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	|ГДЕ
	|	СоответствиеВнешнимИБ.Владелец = &Владелец
	|	И СоответствиеВнешнимИБ.ИмяОбъектаМетаданных = &ИмяОбъектаМетаданных";
	
	Запрос.УстановитьПараметр("Владелец", ИспользуемаяИБ.ТипБД);
	Запрос.УстановитьПараметр("ИмяОбъектаМетаданных", ИмяОбъектаМетаданных);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаСоответствия = Выборка.Ссылка;
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Соответствие.ОбъектТекущейИБ КАК ОбъектТекущейИБ,
	|	Соответствие.НастройкаСоответствия КАК НастройкаСоответствия,
	|	Соответствие.ИспользуемаяИБ КАК ИспользуемаяИБ
	|ИЗ
	|	РегистрСведений.СоответствиеОбъектовТекущейИВнешнихИБ КАК Соответствие
	|ГДЕ
	|	Соответствие.ИспользуемаяИБ = &ИспользуемаяИБ
	|	И Соответствие.НастройкаСоответствия = &НастройкаСоответствия
	|	И Соответствие.ОбъектТекущейИБ = &ОбъектТекущейИБ";
	
	Запрос.УстановитьПараметр("ИспользуемаяИБ", ИспользуемаяИБ);
	Запрос.УстановитьПараметр("НастройкаСоответствия", НастройкаСоответствия);
	Запрос.УстановитьПараметр("ОбъектТекущейИБ", ОбъектТекущейИБ);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	МенеджерЗаписи = РегистрыСведений.СоответствиеОбъектовТекущейИВнешнихИБ.СоздатьМенеджерЗаписи();
	Если Выборка.Следующий() Тогда
		МенеджерЗаписи.ОбъектТекущейИБ = Выборка.ОбъектТекущейИБ;
		МенеджерЗаписи.НастройкаСоответствия = Выборка.НастройкаСоответствия;
		МенеджерЗаписи.ИспользуемаяИБ = Выборка.ИспользуемаяИБ;
	Иначе
		МенеджерЗаписи.ОбъектТекущейИБ = ОбъектТекущейИБ;
		МенеджерЗаписи.ИспользуемаяИБ = ИспользуемаяИБ;
		МенеджерЗаписи.НастройкаСоответствия = НастройкаСоответствия;
	КонецЕсли;
	
	МенеджерЗаписи.ОбъектВнешнейИБ = Строка(ИдентификаторБП);
	МенеджерЗаписи.НаименованиеОбъектаВнешнейИБ = ОбъектТекущейИБ.Наименование;
	МенеджерЗаписи.НастройкаСоответствияНаименование = НастройкаСоответствия.Наименование;
	МенеджерЗаписи.ТипОбъектаТекущейИБ = ИмяОбъектаМетаданных;
	МенеджерЗаписи.ТипОбъектаВнешнейИБ = ИмяОбъектаМетаданных;
	МенеджерЗаписи.ИмяОбъектаТекущейИБ = ОбъектТекущейИБ.Метаданные().ПолноеИмя();
	МенеджерЗаписи.ИмяОбъектаВнешнейИБ = "Справочник." + ИмяОбъектаМетаданных;
	МенеджерЗаписи.GUIDОбъектаТекущейИБ = Строка(ОбъектТекущейИБ.УникальныйИдентификатор());
	МенеджерЗаписи.Выгружено = Истина;
	МенеджерЗаписи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаписатьСобытиеВЖурналРегистрации(НаименованиеОбъекта, ТипСправочника = "", БазаДанных = "",ЭлементПоиска = "", ОшибкаВыгрузки = "")
	
	СтруктураСобытий = Новый Структура("ИмяСобытия, ПредставлениеУровня, Комментарий,ДатаСобытия");
	
	СтруктураСобытий.ИмяСобытия 		 = "ОДМ_Обмен";
	СтруктураСобытий.ПредставлениеУровня = "Ошибка";	
	
	Если ЗначениеЗаполнено(ОшибкаВыгрузки) Тогда
		ТекстСообщения = "Не выгружен " + НаименованиеОбъекта+ "в базу " + БазаДанных + ". Ошибка: " + ОшибкаВыгрузки;
	Иначе
		ТекстСообщения = "Нет связи для " + ТипСправочника +" " + НаименованиеОбъекта+ " для базы " + БазаДанных + " элемент " + ЭлементПоиска;
	КонецЕсли;
	
	СтруктураСобытий.Комментарий = ТекстСообщения;
	СобытияДляЖурналаРегистрации = Новый СписокЗначений();
	СобытияДляЖурналаРегистрации.Добавить(СтруктураСобытий);
	
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СобытияДляЖурналаРегистрации);
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

