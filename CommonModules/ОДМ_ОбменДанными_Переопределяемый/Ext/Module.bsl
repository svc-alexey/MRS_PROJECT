		ИспользуемаяИБ = ОДМ_ОбменДанными.ВернутьДополнительнуюКонстанту("MRS_DataExchange_Base_" + БазаДанных);
		
		РезультатМетода = Новый Структура(
			"Ссылка, Наименование, Код, Владелец, Банк, НомерСчета, ВалютаДенежныхСредств, ВидСчета");
		РезультатМетода.Ссылка = ОДМ_ОбменДанными.УстановитьСвойство(
		"СправочникСсылка.БанковскиеСчета",
		Строка(ОбъектСсылка.Ссылка.УникальныйИдентификатор()));
		РезультатМетода.Наименование = ОДМ_ОбменДанными.УстановитьСвойство("Строка", ОбъектСсылка.Наименование);
		РезультатМетода.Код = ОДМ_ОбменДанными.УстановитьСвойство("Строка", ОбъектСсылка.Код);
		РезультатМетода.НомерСчета = ОДМ_ОбменДанными.УстановитьСвойство("Строка", ОбъектСсылка.НомерСчета);
		РезультатМетода.ВидСчета = ОДМ_ОбменДанными.УстановитьСвойство("Строка", ОбъектСсылка.ВидСчета);
		
		Если ЗначениеЗаполнено(ОбъектСсылка.Банк) Тогда
			СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ОбъектСсылка.Банк);
			Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
				РезультатМетода.Банк = ОДМ_ОбменДанными.УстановитьСвойство("СправочникСсылка.Банки", СоответствиеВнешнейБазы);
			Иначе
				РезультатМетода.Банк = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Банки",
				Строка(ОбъектСсылка.Банк.УникальныйИдентификатор()));
