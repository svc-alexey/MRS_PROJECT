		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОбъектСсылка.ВалютаДенежныхСредств) Тогда
			СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ОбъектСсылка.ВалютаДенежныхСредств);
			Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
				РезультатМетода.ВалютаДенежныхСредств = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Валюты", СоответствиеВнешнейБазы);
			Иначе
				РезультатМетода.ВалютаДенежныхСредств = ОДМ_ОбменДанными.УстановитьСвойство(
				"СправочникСсылка.Валюты",
				Строка(ОбъектСсылка.ВалютаДенежныхСредств.УникальныйИдентификатор()));
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОбъектСсылка.Владелец) Тогда
			УстановитьВладельцаСчетаВОписанииОбмена(РезультатМетода, ИспользуемаяИБ, ОбъектСсылка.Владелец, БазаДанных);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектСсылка.Ссылка) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		
		НаименованиеБазыДанных = БазаДанных.Наименование;
		НаименованиеБазыДанныхКонстанты = ОДМ_ОбменДанными.ВернутьДополнительнуюКонстанту("БазаБПИНН-" + ОбъектСсылка.Организация.ИНН);
		
		Если НаименованиеБазыДанных <> НаименованиеБазыДанныхКонстанты Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Логика для документа ПоступлениеНаРасчетныйСчет
		РезультатМетода = Новый Структура("Ссылка, Дата, Организация, ВидОперации, СчетОрганизации, СчетБанк, Контрагент, СчетКонтрагента, 
		|СуммаДокумента, НомерВходящегоДокумента, ДатаВходящегоДокумента, СчетУчетаРасчетовСКонтрагентом, СтатьяДвиженияДенежныхСредств, 
		| НазначениеПлатежа, Комментарий, ДоговорКонтрагента, ВалютаДокумента, РасшифровкаПлатежа, СубконтоКт1, СубконтоКт2, ПометкаУдаления, СуммаУслуг, 
		| ПодразделениеОрганизации, Ответственный, ПодразделениеКт");
		
		РезультатМетода.Ссылка = ОДМ_ОбменДанными.УстановитьСвойство(
		"ДокументСсылка.ПоступлениеНаРасчетныйСчет", 
		Строка(ОбъектСсылка.Ссылка.УникальныйИдентификатор()));
		
		ИспользуемаяИБ = ОДМ_ОбменДанными.ВернутьДополнительнуюКонстанту("MRS_DataExchange_Base_" + БазаДанных);
		
		// Организация (ГУИД из регистра соответствия)
		СоответствиеВнешнейБазы = ПолучитьСоответствиеВнешнейБазы(ИспользуемаяИБ, ОбъектСсылка.Организация);
		Если ЗначениеЗаполнено(СоответствиеВнешнейБазы) Тогда
