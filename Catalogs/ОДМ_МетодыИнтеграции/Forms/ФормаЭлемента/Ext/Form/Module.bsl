#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокВыбораТипаШаблона();
	
	// Инициализация таблицы параметров
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ИмяПараметра", Новый ОписаниеТипов("Строка"), "ТаблицаПараметров"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("Тип", Новый ОписаниеТипов("Строка"), "ТаблицаПараметров"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("Значение", Новый ОписаниеТипов("Строка"), "ТаблицаПараметров"));
	ИзменитьРеквизиты(МассивРеквизитов);
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ИмяПараметра", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Тип",          Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Значение",     Новый ОписаниеТипов("Строка"));
	ЗначениеВРеквизитФормы(ТЗ, "ТаблицаПараметров");
	
	// Динамические колонки таблицы
	НовоеПоле = Элементы.Добавить("ТаблицаПараметровИмяПараметра", Тип("ПолеФормы"), Элементы.ТаблицаПараметровЗаглушка);
	НовоеПоле.ПутьКДанным = "ТаблицаПараметров.ИмяПараметра";
	НовоеПоле.Заголовок = "Параметр";
	НовоеПоле.ТолькоПросмотр = Истина;
	
	НовоеПоле = Элементы.Добавить("ТаблицаПараметровТип", Тип("ПолеФормы"), Элементы.ТаблицаПараметровЗаглушка);
	НовоеПоле.ПутьКДанным = "ТаблицаПараметров.Тип";
	НовоеПоле.Заголовок = "Тип";
	НовоеПоле.ТолькоПросмотр = Истина;
	
	НовоеПоле = Элементы.Добавить("ТаблицаПараметровЗначение", Тип("ПолеФормы"), Элементы.ТаблицаПараметровЗаглушка);
	НовоеПоле.ПутьКДанным = "ТаблицаПараметров.Значение";
	НовоеПоле.Заголовок = "Значение";
	
	// Синхронизация JSON-полей из объекта
	ПримерJSONЗапроса = Объект.ПримерJSONЗапроса;
	ПримерJSONОтвета  = Объект.ПримерJSONОтвета;
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТипШаблонаПриИзменении(Элемент)
	
	НастроитьЗаголовокШаблона();
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийЭлементовФормы

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораТипаШаблона()
	
	СписокВыбора = Элементы.ТипШаблона.СписокВыбора;
	СписокВыбора.Добавить("ЗаписьОбъектов",  "Запись объектов");
	СписокВыбора.Добавить("Запрос",          "Запрос");
	СписокВыбора.Добавить("Обработчик",      "Обработчик (произвольный код)");
	
	НастроитьЗаголовокШаблонаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЗаголовокШаблонаНаСервере()
	
	ТипШаблона = Объект.ТипШаблона;
	
	Если ТипШаблона = "ЗаписьОбъектов" Тогда
		Элементы.ГруппаШаблон.Заголовок = "Шаблон (BSL-код предобработки данных перед записью объекта; необязательно)";
	ИначеЕсли ТипШаблона = "Запрос" Тогда
		Элементы.ГруппаШаблон.Заголовок = "Шаблон (текст запроса 1С)";
	ИначеЕсли ТипШаблона = "Обработчик" Тогда
		Элементы.ГруппаШаблон.Заголовок = "Шаблон (BSL-код или имя экспортной процедуры)";
	Иначе
		Элементы.ГруппаШаблон.Заголовок = "Шаблон";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьЗаголовокШаблона()
	
	НастроитьЗаголовокШаблонаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПримерЗапроса(Команда)
	
	СформироватьПримерЗапросаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПримерЗапросаНаСервере()
	
	ПримерJSON = ОДМ_ОбменДанными.СформироватьПримерJSONЗапроса(Объект.Ссылка);
	Объект.ПримерJSONЗапроса = ПримерJSON;
	ПримерJSONЗапроса = ПримерJSON;
	
КонецПроцедуры

#Область КомандыInvoke

&НаКлиенте
Процедура ПоставитьВОчередь(Команда)

	Если ПустаяСтрока(ПримерJSONЗапроса) Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru='Сначала сформируйте или введите JSON-запрос'"), , "ПредпросмотрJSON");
		Возврат;
	КонецЕсли;

	GUID = ПоставитьВОчередьНаСервере(Объект.Код, ПримерJSONЗапроса);

	Текст = СтрШаблон(НСтр("ru='Задача поставлена в очередь: %1'"), GUID);
	ПоказатьОповещениеПользователя(Текст);

КонецПроцедуры

&НаСервере
Функция ПоставитьВОчередьНаСервере(Знач КодШаблона, Знач ТекстJSON)

	ПараметрыОтправки = ОДМ_ОбменДанными.ДесериализоватьJSON(ТекстJSON);
	Возврат ОДМ_ОбменДанными.СоздатьЗадачуInvokeВОчередь(КодШаблона, ПараметрыОтправки,
		ПереиспользуемаяЗадача);

КонецФункции

&НаКлиенте
Процедура ВыполнитьСинхронно(Команда)
	
	Если ПустаяСтрока(ПримерJSONЗапроса) Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru='Сначала сформируйте или введите JSON-запрос'"), , "ПредпросмотрJSON");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(БазаПолучатель) Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru='Выберите базу-получатель'"));
		Возврат;
	КонецЕсли;
	
	ВыполнитьСинхронноНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСинхронноНаСервере()
	
	ВнешнийИнтерфейс = ОДМ_ОбменДанными.Конструктор_ВнешнийИнтерфейс();
	
	ЗначенияРеквизитов = ОДМ_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		БазаПолучатель, "СерверПубликации, ИмяПубликации, Логин, Пароль");
	
	ВнешнийИнтерфейс.АдресСервера = ЗначенияРеквизитов.СерверПубликации;
	ВнешнийИнтерфейс.ИмяБазы      = ЗначенияРеквизитов.ИмяПубликации;
	ВнешнийИнтерфейс.Логин        = ЗначенияРеквизитов.Логин;
	ВнешнийИнтерфейс.Пароль       = ЗначенияРеквизитов.Пароль;
	
	Попытка
		РезультатПодключения = ВнешнийИнтерфейс.УстановитьХТТПСоединение();
		Если НЕ РезультатПодключения.Успех Тогда
			Объект.ПримерJSONОтвета = РезультатПодключения.ДополнительнаяИнформация;
			Возврат;
		КонецЕсли;
		
		Тело = ОДМ_ОбменДанными.ДесериализоватьJSON(ПримерJSONЗапроса);
		Ответ = ВнешнийИнтерфейс.ОтправитьInvokeНаСервер(Тело);
		
		Объект.ПримерJSONОтвета = ОДМ_ОбменДанными.СериализоватьJSON(Ответ);
		
	Исключение
		Объект.ПримерJSONОтвета = ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВБазу(Команда)
	
	Если ПустаяСтрока(ПримерJSONЗапроса) Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru='Сначала сформируйте или введите JSON-запрос'"), , "ПредпросмотрJSON");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(БазаПолучатель) Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru='Выберите базу-получатель'"));
		Возврат;
	КонецЕсли;
	
	GUID = ОтправитьВБазуНаСервере();
	
	Текст = СтрШаблон(НСтр("ru='Задача отправки создана: %1'"), GUID);
	ПоказатьОповещениеПользователя(Текст);
	
КонецПроцедуры

&НаСервере
Функция ОтправитьВБазуНаСервере()
	
	Параметры = ОДМ_ОбменДанными.ДесериализоватьJSON(ПримерJSONЗапроса);
	
	// Убираем "Шаблон" - он передаётся отдельным параметром
	Если Параметры.Свойство("Шаблон") Тогда
		Параметры.Удалить("Шаблон");
	КонецЕсли;
	
	// Определяем код шаблона для базы-получателя:
	// если пользователь явно указал код - используем его,
	// иначе берём код текущего шаблона (Объект.Код)
	КодШаблона = ?(ПустаяСтрока(КодШаблонаПолучателя), Объект.Код, КодШаблонаПолучателя);
	
	Возврат ОДМ_ОбменДанными.СоздатьЗадачуInvokeОтправкиПоБазе(
		БазаПолучатель, КодШаблона, Параметры, ПереиспользуемаяЗадача);
	
КонецФункции

#КонецОбласти

#Область ДинамическиеПараметры

&НаКлиенте
Процедура ЗаполнитьИзТЧ(Команда)
	
	ЗаполнитьИзТЧНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзТЧНаСервере()
	
	ТаблицаПараметров.Очистить();
	
	Для Каждого СтрокаТЧ Из Объект.ВходныеПараметры Цикл
		НоваяСтрока = ТаблицаПараметров.Добавить();
		НоваяСтрока.ИмяПараметра = СтрокаТЧ.ИмяПараметра;
		НоваяСтрока.Тип          = СтрокаТЧ.Тип;
		НоваяСтрока.Значение     = "";
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СобратьJSON(Команда)
	
	СобратьJSONНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СобратьJSONНаСервере()
	
	Данные = Новый Структура;
	Данные.Вставить("Шаблон", Объект.Код);
	
	Для Каждого Строка Из ТаблицаПараметров Цикл
		Если ПустаяСтрока(Строка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Строка.Тип = "Число" Тогда
			Данные.Вставить(Строка.ИмяПараметра, Число(Строка.Значение));
		ИначеЕсли Строка.Тип = "Булево" Тогда
			Данные.Вставить(Строка.ИмяПараметра, Булево(Строка.Значение));
		Иначе
			Данные.Вставить(Строка.ИмяПараметра, Строка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Объект.ПримерJSONЗапроса = ОДМ_ОбменДанными.СериализоватьJSON(Данные);
	ПримерJSONЗапроса = Объект.ПримерJSONЗапроса;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти // СлужебныеПроцедурыИФункции
