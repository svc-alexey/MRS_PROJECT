#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Для Каждого элК Из ЭтотОбъект["_ОДМ_РедакторыJSON"] Цикл
		Попытка
			// Извлекаем текст body и вырезаем чистый JSON
			Текст = Элементы[элК.Значение].Документ.body.textContent;
			Текст = ИзвлечьJSONИзТекста(Текст);
			Если Текст <> Неопределено Тогда
				ЭтотОбъект[элК.Представление] = Текст;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьJSONИзТекста(Текст)
	
	// Ищем начало JSON — первый { или [
	ПозНачало = СтрНайти(Текст, "{");
	Если ПозНачало = 0 Тогда
		ПозНачало = СтрНайти(Текст, "[");
	КонецЕсли;
	Если ПозНачало = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Отрезаем всё до начала JSON
	Текст = Сред(Текст, ПозНачало);
	
	// Ищем последнюю } или ]
	ПозКонец = СтрДлина(Текст);
	Пока ПозКонец > 0 Цикл
		Символ = Сред(Текст, ПозКонец, 1);
		Если Символ = "}" ИЛИ Символ = "]" Тогда
			Прервать;
		КонецЕсли;
		ПозКонец = ПозКонец - 1;
	КонецЦикла;
	
	Если ПозКонец = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Лев(Текст, ПозКонец);
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокВыбораТипаШаблона();
	
	// Единый ИзменитьРеквизиты: зеркала JSON-редактора + колонки таблицы
	МассивРеквизитов = Новый Массив;
	
	// Зеркальные реквизиты JSON-редактора (только для JSON-полей, не для Шаблон)
	МассивРеквизитов.Добавить(Новый РеквизитФормы("_ОДМ_РедакторыJSON", Новый ОписаниеТипов("СписокЗначений")));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("_ОДМ_ПримерJSONЗапроса", ОДМ_ОбщегоНазначения.ОписаниеТипаСтрока(1000)));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("_ОДМ_ПримерJSONОтвета", ОДМ_ОбщегоНазначения.ОписаниеТипаСтрока(1000)));
	
	// Колонки таблицы параметров
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ИмяПараметра", Новый ОписаниеТипов("Строка"), "ТаблицаПараметров"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("Тип", Новый ОписаниеТипов("Строка"), "ТаблицаПараметров"));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("Значение", Новый ОписаниеТипов("Строка"), "ТаблицаПараметров"));
	
	ИзменитьРеквизиты(МассивРеквизитов);
	
	// Манипуляция элементами JSON-редактора: копируем поля как HTML, скрываем оригиналы
	// Шаблон — обычное поле, не участвует в JSON-редакторе
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("ПримерJSONЗапроса");
	ИменаПолей.Добавить("ПримерJSONОтвета");
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЭлементФормы = Элементы[ИмяПоля];
		НовыйЭлемент = ОДМ_УправлениеФормами_Сервер.СкопироватьЭлементФормы(ЭтотОбъект, ЭлементФормы, ЭлементФормы.Родитель);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеHTMLДокумента;
		НовыйЭлемент.ТолькоПросмотр = Ложь;
		НовыйЭлемент.ПутьКДанным = НовыйЭлемент.Имя;
		ЭлементФормы.Видимость = Ложь;
		ЭтотОбъект["_ОДМ_РедакторыJSON"].Добавить(НовыйЭлемент.Имя, ИмяПоля);
	КонецЦикла;
	
	// Таблица параметров — данные через ЗначениеВРеквизитФормы
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ИмяПараметра", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Тип",          Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Значение",     Новый ОписаниеТипов("Строка"));
	ЗначениеВРеквизитФормы(ТЗ, "ТаблицаПараметров");
	
	// Динамически добавляем колонки в таблицу формы
	НовоеПоле = Элементы.Добавить("ТаблицаПараметровИмяПараметра", Тип("ПолеФормы"), Элементы.ТаблицаПараметровЗаглушка);
	НовоеПоле.ПутьКДанным = "ТаблицаПараметров.ИмяПараметра";
	НовоеПоле.Заголовок = "Параметр";
	НовоеПоле.ТолькоПросмотр = Истина;
	
	НовоеПоле = Элементы.Добавить("ТаблицаПараметровТип", Тип("ПолеФормы"), Элементы.ТаблицаПараметровЗаглушка);
	НовоеПоле.ПутьКДанным = "ТаблицаПараметров.Тип";
	НовоеПоле.Заголовок = "Тип";
	НовоеПоле.ТолькоПросмотр = Истина;
	
	НовоеПоле = Элементы.Добавить("ТаблицаПараметровЗначение", Тип("ПолеФормы"), Элементы.ТаблицаПараметровЗаглушка);
	НовоеПоле.ПутьКДанным = "ТаблицаПараметров.Значение";
	НовоеПоле.Заголовок = "Значение";
	
	// Синхронизация: Объект → зеркальные form-атрибуты (для существующих записей)
	СинхронизироватьЗеркалаИзОбъекта();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОДМ_УправлениеФормами_Клиент.ИнициализацияРедактораJSON_ПриОткрытииФормы(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

